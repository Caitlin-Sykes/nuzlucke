{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.1.0",
    "generators": {
      "nuzlucke-client": {
        "inputSpec": "http://localhost:8080/nuzlucke/api",
        "generatorName": "typescript-fetch",
        "output": "./src/generated/api",
        "additionalProperties": {
          "useJSDoc": true,
          "useES6": true
        }
      }
    }
  }
}